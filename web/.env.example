# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build email confirmation redirect links; set to your deployed
# origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Get these from your Stripe Dashboard → Developers → API keys (test mode).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Set after running `stripe listen` locally, or from the Stripe Dashboard
# webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
